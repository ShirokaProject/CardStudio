<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:icons="using:Material3.Avalonia.Icons"
             xmlns:material="using:Material3.Avalonia.Controls"
             x:Class="CardStudio.CardStudioView"
             Background="{DynamicResource StudioSurface}" Foreground="{DynamicResource StudioText}">
  <UserControl.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Height" Value="34" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="13,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox.toolbar">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="54,*,30">
    <Border Grid.Row="0" BorderBrush="{DynamicResource StudioOutline}" BorderThickness="0,0,0,1">
      <Grid Margin="16,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="10" Background="#286FEA">
            <Path Width="22" Height="22" Stretch="Uniform" Fill="Transparent"
                  Stroke="White" StrokeThickness="3" StrokeLineCap="Round"
                  Data="M17,9 H31 C36,9 39,12 39,17 V31 C39,36 36,39 31,39 H17 C12,39 9,36 9,31 V17 C9,12 12,9 17,9 Z M16,20 H32 M16,28 H27"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="CardStudio" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                    VerticalAlignment="Center">
          <Button x:Name="OpenButton" Classes="toolbar" Content="打开" />
          <Button x:Name="SaveButton" Classes="toolbar" Content="保存" />
          <Button x:Name="RefreshButton" Classes="toolbar" Content="运行" />
          <Button x:Name="SampleButton" Classes="toolbar" Content="示例" />
          <Button Classes="toolbar" Content="导入图片资源" Margin="15,0,0,0">
            <Button.Flyout><Flyout><StackPanel Width="320" Spacing="10">
              <TextBlock Text="临时图片资源" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportImagesButton" Content="导入图片" />
                <Button x:Name="ClearImagesButton" Content="清空" />
              </StackPanel>
              <ListBox x:Name="ImageAssetsList" Height="180" />
              <Button x:Name="InsertImageButton" Content="插入到 AXAML 光标处" />
              <TextBlock x:Name="ImageAssetsHint" Text="保存在本机，下次打开仍可使用。" FontSize="11" TextWrapping="Wrap" />
            </StackPanel></Flyout></Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <Button x:Name="LoadAssemblyButton" Classes="toolbar" Content="加载 DLL" />
          <ComboBox x:Name="ControlTypeCombo" Classes="toolbar" Width="125" IsEnabled="False" />
          <Button x:Name="InsertTypeButton" Classes="toolbar" Content="插入控件" IsEnabled="False" />
          <Button x:Name="ThemeButton" Classes="toolbar" Content="浅色" />
          <Button x:Name="CopyButton" Classes="toolbar" Content="复制 PNG" IsEnabled="False" />
          <Button x:Name="DownloadButton" Classes="toolbar" Width="36" Padding="8,4"
                  ToolTip.Tip="下载 PNG" IsEnabled="False">
            <PathIcon Width="18" Height="18"
                      Data="{x:Static icons:MaterialSymbols.Download}" />
          </Button>
          <TextBox x:Name="DpiBox" Width="64" Height="34" MinHeight="0" Text="192"
                   Padding="0" FontSize="14" TextAlignment="Center"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"
                   PlaceholderText="DPI" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*,5,*" MinHeight="0">
      <Grid Grid.Column="0" RowDefinitions="Auto,*" MinHeight="0">
        <Grid Margin="20,14,20,8" ColumnDefinitions="*,Auto">
          <TextBlock Text="代码" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="编辑后自动刷新" FontSize="12"
                     Foreground="{DynamicResource StudioMuted}" VerticalAlignment="Center" />
        </Grid>
        <TabControl x:Name="EditorTabs" Grid.Row="1" TabStripPlacement="Bottom"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Background="{DynamicResource StudioSurface}" Foreground="{DynamicResource StudioText}">
          <TabItem Header="AXAML" Height="40" VerticalContentAlignment="Center">
            <editor:TextEditor x:Name="CodeEditor" Margin="8,0,8,4"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     ShowLineNumbers="True"
                     FontFamily="Menlo, Consolas, monospace"
                     FontSize="13" Foreground="{DynamicResource StudioText}" Background="{DynamicResource StudioEditorSurface}" />
          </TabItem>
          <TabItem Header="C#" Height="40" VerticalContentAlignment="Center">
            <editor:TextEditor x:Name="CSharpEditor" Margin="8,0,8,4"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     ShowLineNumbers="True"
                     FontFamily="Menlo, Consolas, monospace"
                     FontSize="13" Foreground="{DynamicResource StudioText}" Background="{DynamicResource StudioEditorSurface}" />
          </TabItem>
          <TabItem Header="ViewModel（可选）" Height="40" VerticalContentAlignment="Center">
            <editor:TextEditor x:Name="ViewModelEditor" Margin="8,0,8,4"
                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                     ShowLineNumbers="True"
                     FontFamily="Menlo, Consolas, monospace"
                     FontSize="13" Foreground="{DynamicResource StudioText}" Background="{DynamicResource StudioEditorSurface}" />
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource StudioSplitter}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" MinHeight="0">
        <Grid Margin="20,14,20,8" ColumnDefinitions="*,Auto">
          <TextBlock Text="预览" FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="PreviewMetaText" Grid.Column="1" Text="等待渲染"
                     FontSize="12" Foreground="{DynamicResource StudioMuted}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
          <Border Background="{DynamicResource StudioPreviewSurface}" Padding="20" ClipToBounds="True">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
              <ThemeVariantScope x:Name="CardThemeScope">
                <ThemeVariantScope.Styles>
                  <FluentTheme />
                </ThemeVariantScope.Styles>
                <ContentControl x:Name="CardHost" HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
              </ThemeVariantScope>
            </Viewbox>
          </Border>
          <Border x:Name="PreviewLoadingOverlay" IsVisible="False" Background="{DynamicResource StudioBusySurface}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
              <material:CircularProgressIndicator Width="48" Height="48"
                                                  IsIndeterminate="True" IsWavy="True"
                                                  StrokeWidth="4" Amplitude="2" WaveCount="5"
                                                  Foreground="{DynamicResource StudioPrimary}" Background="{DynamicResource StudioProgressTrack}"
                                                  HorizontalAlignment="Center" />
              <TextBlock Text="正在编译并渲染…" FontSize="14" Foreground="{DynamicResource StudioBusyText}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="ErrorPanel" Grid.Row="2" IsVisible="False"
                Padding="12,9" Background="{DynamicResource StudioErrorSurface}">
          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource StudioErrorText}" FontSize="12"
                     TextWrapping="Wrap" MaxHeight="110" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{DynamicResource StudioOutline}" BorderThickness="0,1,0,0">
      <Grid Margin="16,0" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="11"
                   Foreground="{DynamicResource StudioMuted}" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11"
                   Foreground="{DynamicResource StudioMuted}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
