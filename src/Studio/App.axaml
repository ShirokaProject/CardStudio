<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m3="using:Material3.Avalonia"
             xmlns:completion="using:AvaloniaEdit.CodeCompletion"
             xmlns:search="using:AvaloniaEdit.Search"
             x:Class="CardStudio.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="StudioSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="StudioEditorSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="StudioCompletionSurface">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="StudioPreviewSurface">#F3F5F8</SolidColorBrush>
          <SolidColorBrush x:Key="StudioText">#191C20</SolidColorBrush>
          <SolidColorBrush x:Key="StudioMuted">#667386</SolidColorBrush>
          <SolidColorBrush x:Key="StudioOutline">#E1E4E9</SolidColorBrush>
          <SolidColorBrush x:Key="StudioSplitter">#D9DEE7</SolidColorBrush>
          <SolidColorBrush x:Key="StudioBusySurface">#DDF3F5F8</SolidColorBrush>
          <SolidColorBrush x:Key="StudioBusyText">#40516B</SolidColorBrush>
          <SolidColorBrush x:Key="StudioPrimary">#286FEA</SolidColorBrush>
          <SolidColorBrush x:Key="StudioProgressTrack">#D6E2F4</SolidColorBrush>
          <SolidColorBrush x:Key="StudioErrorSurface">#FFF0F0</SolidColorBrush>
          <SolidColorBrush x:Key="StudioErrorText">#B53443</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="StudioSurface">#111318</SolidColorBrush>
          <SolidColorBrush x:Key="StudioEditorSurface">#17191F</SolidColorBrush>
          <SolidColorBrush x:Key="StudioCompletionSurface">#252A34</SolidColorBrush>
          <SolidColorBrush x:Key="StudioPreviewSurface">#0D1017</SolidColorBrush>
          <SolidColorBrush x:Key="StudioText">#E2E2E9</SolidColorBrush>
          <SolidColorBrush x:Key="StudioMuted">#ADB8C9</SolidColorBrush>
          <SolidColorBrush x:Key="StudioOutline">#343B46</SolidColorBrush>
          <SolidColorBrush x:Key="StudioSplitter">#343B46</SolidColorBrush>
          <SolidColorBrush x:Key="StudioBusySurface">#DD171B24</SolidColorBrush>
          <SolidColorBrush x:Key="StudioBusyText">#C0CCDF</SolidColorBrush>
          <SolidColorBrush x:Key="StudioPrimary">#ADC6FF</SolidColorBrush>
          <SolidColorBrush x:Key="StudioProgressTrack">#3C4655</SolidColorBrush>
          <SolidColorBrush x:Key="StudioErrorSurface">#422526</SolidColorBrush>
          <SolidColorBrush x:Key="StudioErrorText">#FFB4AB</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <m3:MaterialTheme SeedColor="#286FEA" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <Style Selector="search|SearchPanel">
      <Setter Property="Background" Value="{DynamicResource StudioCompletionSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,8,12,0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox">
      <Setter Property="Background" Value="{DynamicResource StudioEditorSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioOutline}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="search|SearchPanel /template/ Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="7,5" />
    </Style>
    <Style Selector="search|SearchPanel /template/ Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioPreviewSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox ToggleButton">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Viewbox Width="14" Height="14" Stretch="Uniform">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox ToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource StudioPreviewSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox ToggleButton:checked">
      <Setter Property="Background" Value="{DynamicResource StudioProgressTrack}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioPrimary}" />
    </Style>
    <Style Selector="search|SearchPanel /template/ TextBox ToggleButton Path">
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="completion|CompletionTipContentControl">
      <Setter Property="Background" Value="{DynamicResource StudioCompletionSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StudioOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
